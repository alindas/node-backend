{
  "name": "admin",
  "version": "1.0.0",
  "description": "Your project description",
  "main": "src/app.js",
  "scripts": {
    "start": "babel-node src/app.js",
    "dev": "cross-env NODE_ENV=development nodemon --exec babel-node src/app.js",
    "prebuild": "rimraf dist",
    "build": "babel src -d dist",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint --fix . --ext .js ",
    "format": "prettier --write \"src/**/*.js\"",
    "prepare": "husky install",
    "lint-format": "npm run lint:fix && npm run format",
    "pm2:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:prod": "pm2-runtime start ecosystem.config.js --env production",
    "pm2:deploy:prod": "pm2 deploy ecosystem.config.js production",
    "add:model": "node src/scripts/add_new_model.js",
    "docker:build": "docker build -t your-app-name ."
  },
  "dependencies": {
    "@koa/cors": "^4.0.0",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "ioredis": "^5.3.2",
    "ip2region": "^2.3.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "koa": "^2.14.2",
    "koa-body": "^6.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-json": "^2.0.2",
    "koa-logger": "^3.2.1",
    "koa-onerror": "^4.2.0",
    "koa-router": "^12.0.0",
    "koa-session": "^6.4.0",
    "koa-static": "^5.0.0",
    "koa-useragent": "^4.1.0",
    "log4js": "^6.9.1",
    "module-alias": "^2.2.3",
    "mysql2": "^3.6.0",
    "pm2": "^5.4.3",
    "ramda": "^0.29.0",
    "sequelize": "^6.32.1",
    "sequelize-auto": "^0.8.8",
    "svg-captcha": "^1.4.0",
    "winston": "^3.x.x",
    "winston-daily-rotate-file": "^4.x.x"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.0",
    "@babel/core": "^7.26.0",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/node": "^7.26.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "^7.26.0",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "commitizen": "^4.3.1",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.11",
    "nodemon": "^3.0.1",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  }
}
